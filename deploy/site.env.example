# Copy to deploy/site.env on the server and fill in. site.env is gitignored:
# the public repo never names the site or the server.

# The site's public address. The tunnel sends it to nginx on 127.0.0.1:80.
HOST=cybersweeper.example.com

# The existing Cloudflare tunnel to add it to (one tunnel serves every hostname).
TUNNEL=my-tunnel

# Optional; these are the defaults.
#WEBROOT=/var/www/cybersweeper
#CF_CONFIG=/etc/cloudflared/config.yml
#CF_READY=http://127.0.0.1:20241/ready
